          isAdmin()
        );
      allow update: if isVerifiedUser() && isValidId(profileId) && isValidProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            existing().ownerUid == request.auth.uid &&
            incoming().role == existing().role &&
            incoming().status == existing().status &&
            incoming().departmentId == existing().departmentId &&
            incoming().designation == existing().designation &&
            incoming().managerUid == existing().managerUid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'avatarInitials', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(profileId) && isAdmin();
