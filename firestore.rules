        );
      allow update: if isVerifiedUser() && isValidId(userId) && isValidProfilePrivate(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            (request.auth.uid == userId || existing().ownerUid == request.auth.uid) &&
            incoming().email == existing().email &&
            incoming().diff(existing()).affectedKeys().hasOnly(['contactNumber', 'emergencyContact', 'address', 'updatedAt'])
