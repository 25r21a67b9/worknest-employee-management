      allow update: if isVerifiedUser() && isValidId(holidayId) && isValidHoliday(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdByUid == existing().createdByUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow delete: if isVerifiedUser() && isValidId(holidayId) && isAdmin();
    }

    // =========================================================================
    // COLLECTION 16: /company_settings/{settingId}
    // =========================================================================
    match /company_settings/{settingId} {
      allow get: if isVerifiedUser() && isValidId(settingId) && (
        existing().status == 'active' || isAdmin()
      );
      allow list: if false;
      allow create: if isVerifiedUser() && isValidId(settingId) && isValidCompanySettings(incoming()) &&
        incoming().id == settingId &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() && isValidId(settingId) && isValidCompanySettings(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow delete: if isVerifiedUser() && isValidId(settingId) && isAdmin();
    }

    // =========================================================================
    // COLLECTION 17: /audit_logs/{logId} (Immutable Audit Trail)
    // =========================================================================
    match /audit_logs/{logId} {
      allow get: if isVerifiedUser() && isValidId(logId) && (
        existing().actorUid == request.auth.uid ||
        existing().hrUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isVerifiedUser() && (
        existing().actorUid == request.auth.uid ||
        existing().hrUid == request.auth.uid ||
        isBootstrappedAdmin()
      );
      allow create: if isVerifiedUser() && isValidId(logId) && isValidAuditLog(incoming()) &&
        incoming().id == logId &&
        incoming().actorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update, delete: if false;
    }

  }
}
