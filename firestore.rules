      allow create: if isVerifiedUser() && isValidId(adminUid) && isValidAdminRecord(incoming()) &&
        incoming().uid == adminUid &&
        incoming().grantedByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() && isValidId(adminUid) && isValidAdminRecord(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
